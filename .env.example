# Copy to .env (never commit .env). Compose reads it automatically.

# --- Airflow User ID (match your host WSL user UID, usually 1000) ---
AIRFLOW_UID=1000

# --- Vault (mounted read-only into the app and airflow containers) ---
VAULT_PATH=/mnt/c/Users/Home/Documents/notes

# --- Elasticsearch ---
# Keep the server major version equal to the python client major (elasticsearch>=8,<9 in pyproject.toml).
ES_VERSION=8.17.0
ES_HEAP=512m

# --- Indexing pipeline overrides (optional; defaults live in config/vaultlens.yaml) ---
# PARSER=default
# CHUNKER=heading
# CHUNK_MAX_CHARS=1500
# CHUNK_OVERLAP=0
# (embedding_model lives in config/vaultlens.yaml under index.embedding_model)

# --- LLM (Ollama runs on Windows host, Gemini, or Groq) ---
LLM_PROVIDER=ollama
LLM_DEFAULT_PROVIDER=ollama        # off | ollama | gemini | groq
LLM_TIMEOUT=180

# Ollama (running on Windows host)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
OLLAMA_KEEP_ALIVE=10m

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (free-tier models: openai/gpt-oss-120b, qwen/qwen3.8-27b)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Semantic search / AI tiers (ADR-0009). Defaults shown; uncomment to override. ---
# New tiers (AI Search, Agentic) use Groq or Gemini only (LLM_PROVIDER=groq|gemini).
# EMBED_PROVIDER=sentence_transformers   # or ollama (model set in config/vaultlens.yaml)
# EMBED_DIMS=1024
# EMBED_MAX_TOKENS=512
# EMBED_BATCH=16
# RERANK_ENABLED=true
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANK_MODE=blend                      # or replace
# RERANK_POOL=20
# HYBRID_CANDIDATES=30
# RRF_K=60
# AGENT_MAX_ITERATIONS=3
# AGENT_MAX_LLM_CALLS=8
# AGENT_TIMEOUT_S=120
# AGENT_MIN_HITS=3
